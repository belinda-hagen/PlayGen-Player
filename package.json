{
  "name": "playgen",
  "version": "1.3.0",
  "description": "YouTube music downloader & playlist manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npx electron-packager . PlayGen --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/playgen-icon.ico --ignore=\"dist|.git|.gitignore\" --asar --extra-resource=assets/bin",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage --x64"
  },
  "keywords": [
    "electron",
    "youtube",
    "music",
    "playlist"
  ],
  "author": "PlayGen",
  "license": "MIT",
  "build": {
    "appId": "com.playgen.app",
    "productName": "PlayGen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "!assets/bin/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/playgen-icon.ico",
      "extraResources": [
        {
          "from": "assets/bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/playgen-icon.ico",
      "uninstallerIcon": "assets/playgen-icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
